{
  "$schema": "https://raw.githubusercontent.com/nicegram/tauri-v2-schemas/refs/heads/main/2.1.1/json-schema/tauri-conf.schema.json",
  "productName": "DBReader",
  "version": "0.1.0",
  "identifier": "com.vincentleong.dbreader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://192.168.1.161:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}